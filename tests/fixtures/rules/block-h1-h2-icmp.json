{
  "name": "Block h1 to h2 ICMP",
  "description": "One-way ping block from h1 to h2",
  "enabled": true,
  "priority": 100,
  "action": "block",
  "direction": "one-way",
  "stateful": false,
  "match": {
    "src_ip": "10.0.0.1",
    "dst_ip": "10.0.0.2",
    "proto": "icmp"
  },
  "scope": {
    "switches": "all"
  },
  "logging": {
    "enabled": true,
    "sample_rate": 1.0
  },
  "stats": {
    "enabled": true
  }
}
